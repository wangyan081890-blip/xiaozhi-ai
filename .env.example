# ===========================================================================
# 小智 AI 云端版环境变量示例
# 复制为 .env 后填写；.env 已被 .gitignore / .dockerignore 排除，不会进镜像。
# ===========================================================================

# --- 对外访问 ---------------------------------------------------------------
# 本地调试：留空（Caddy 监听 :80）
# 正式上线：填你的域名（先解析 A 记录到服务器 IP），例如 xiaozhi.example.com
# Caddy 会为该域名自动申请 HTTPS 证书。
SITE_ADDRESS=

# --- 数据库 ----------------------------------------------------------------
# docker compose 会用下面三项自动拼出 DATABASE_URL，无需手写；
# 若使用外部 PostgreSQL，可取消注释并直接指定 DATABASE_URL。
POSTGRES_PASSWORD=请替换为强密码-至少16位
# DATABASE_URL=postgresql+psycopg://xiaozhi:密码@db:5432/xiaozhi

# --- 身份 Cookie -----------------------------------------------------------
# 生产环境务必固定下来（重启后不会让所有人掉登录态）。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# auto: HTTPS 下自动加 Secure；也可强制设为 true / false
COOKIE_SECURE=auto

# --- 在线大模型（OpenAI 兼容接口） ----------------------------------------
# 任选一个配置即可；配置了多个时，前端可切换。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen3-8B

ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# 通义千问（阿里云百炼 DashScope，OpenAI 兼容模式）
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 任意兼容 /v1/chat/completions 的服务（三项都填才会启用）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# 默认使用的服务商：deepseek / siliconflow / zhipu / dashscope / openai / custom / ollama
DEFAULT_PROVIDER=deepseek

# --- 本地 Ollama（仅开发测试） ---------------------------------------------
OLLAMA_ENABLED=false
# LOCAL_BASE_URL=http://127.0.0.1:11434
# LOCAL_MODEL=qwen3:8b

# --- 业务限制（可选） -------------------------------------------------------
# MAX_HISTORY_MESSAGES=24
# MAX_MESSAGE_CHARS=4000
# RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT=4
# MAX_MESSAGES_PER_SESSION=4000
# ONLINE_TIMEOUT=120
# ONLINE_MAX_RETRIES=2
# ONLINE_TEMPERATURE=0.7
