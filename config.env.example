# 本地开发配置示例（复制为 config.env 或 .env）
# Docker 部署请改用 .env.example。

# 本地默认 SQLite；也可直接设 DATABASE_URL=postgresql+psycopg://...
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/xiaozhi.db

# 身份 Cookie 签名密钥（开发可留空自动生成；生产必须固定）
# SECRET_KEY=

# 只启用本地 Ollama 测试时：
OLLAMA_ENABLED=false
# LOCAL_BASE_URL=http://127.0.0.1:11434
# LOCAL_MODEL=qwen3:8b

# 在线模型（任选其一）
# DEEPSEEK_API_KEY=sk-xxx
# DEFAULT_PROVIDER=deepseek

# 用 scripts/mock_openai.py 联调时，取消以下注释：
# CUSTOM_API_KEY=test-key
# CUSTOM_BASE_URL=http://127.0.0.1:11436/v1
# CUSTOM_MODEL=mock-model
# DEFAULT_PROVIDER=custom

# 限流与并发（可选）
# RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT=4
# MAX_HISTORY_MESSAGES=24
